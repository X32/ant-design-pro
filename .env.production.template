# 生产环境配置文件
# 部署到服务器前请修改此文件

# ==================================
# API 配置
# ==================================

# 后端 API 地址
# 方式一：使用域名（推荐）
# API_BASE_URL=https://api.yourdomain.com

# 方式二：使用 IP 地址
# API_BASE_URL=http://你的服务器IP:9003

# 方式三：使用 Nginx 反向代理（推荐）
# 如果前后端部署在同一服务器，可以留空
# 前端会通过 Nginx 代理访问后端
API_BASE_URL=

# ==================================
# WebSocket 配置（如果需要）
# ==================================

# WebSocket 地址
# WS_BASE_URL=wss://api.yourdomain.com
# 或者
# WS_BASE_URL=ws://你的服务器IP:9003

# ==================================
# 其他配置
# ==================================

# 环境标识
NODE_ENV=production

# 是否启用调试模式（生产环境建议关闭）
DEBUG=false

# CDN 地址（如果使用 CDN）
# PUBLIC_PATH=https://cdn.yourdomain.com/

# ==================================
# 配置说明
# ==================================
#
# 1. API_BASE_URL 配置建议：
#    - 如果前后端部署在同一服务器：留空，使用 Nginx 反向代理
#    - 如果前后端分离部署：填写完整的后端 API 地址
#    - 生产环境务必使用 HTTPS（麦克风功能需要）
#
# 2. 修改后需要重新构建：
#    npm run build
#
# 3. 如何验证配置：
#    - 构建后检查 dist/umi.js 中是否包含正确的 API 地址
#    - 部署后打开浏览器控制台（F12）查看网络请求
#
# ==================================
